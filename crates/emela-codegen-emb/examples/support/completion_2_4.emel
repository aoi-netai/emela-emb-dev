@external(c,"host_text")
fn text(n: Int) -> String use {}
@external(c,"host_wait")
suspend fn wait(n: Int) -> Int
effect Wait { suspend fn get(n: Int) -> Int }
handler Waiting: Wait { suspend fn get(n,resume) { resume(wait(n)) } }
const IDENTITY = { dbg("IDENTITY")
 fn(value) { value }
}
pub enum Grow[A] { End(A), Next(Grow[List[A]]) } derive Eq, Show
pub fn work(deep: Bool) -> Int use Async {
 message = text(42)
 value: Grow[String] = if deep { Next(End([message])) } else { End(message) }
 with Waiting { (use Wait).get(42) }
 bytes = value match {
  End(s) -> String.byte_size(IDENTITY(s))
  Next(rest) -> rest match {
   End(xs) -> List.length(xs) + 1
   Next(_) -> 0
  }
 }
 IDENTITY(40) + bytes
}
