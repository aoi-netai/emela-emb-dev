@external(c, "runtime_mark")
fn runtime_mark(n: Int) -> () use {}
effect RuntimeResource { fn read() -> Int }
handler RuntimeResourceImpl implements RuntimeResource {
  fn read() { 1 }
  release {
    runtime_mark(2)
    (use Wait).get(3)
    runtime_mark(3)
  }
}
pub fn cancel_cleanup() -> Int use Async {
  with Waiting {
    result = Fiber.scope(fn() {
      Fiber.fork(fn() {
        with RuntimeResourceImpl {
          runtime_mark(1)
          (use Wait).get(1)
        }
      })
      (use Wait).get(2)
    })
    runtime_mark(4)
    result
  }
}
pub fn float_roundtrip(value: Float) -> Float {
  Float.parse(Float.to_string(value)) escape { ParseError(input) -> 123.0 }
}
pub fn unicode_signature(value: String) -> Int {
  String.length(value) * 100 + List.length(String.chars(value))
}
