import Std.Embedded.Uart
import Std.Embedded.Gpio
import Std.Embedded.Interrupt
import Std.Embedded.Board.{BoardUart}

const ID = Uart.Uart1
const CALLBACK = on_uart
error Message(text: String)
fn on_uart(id: Uart.UartId, event: Uart.UartEvent) -> () fails {} use {Gpio.Gpio} {
  pin = id match { Uart.Uart1 -> Gpio.GpioPin(1)
    _ -> Gpio.GpioPin(2) }
  state = event match {
    Uart.Received(value) -> if value == 511 { Gpio.High } else { Gpio.Low }
    Uart.TransmitComplete -> Gpio.High
    Uart.ReceiveError(errors) -> if errors.parity && errors.framing && errors.overrun && errors.other { Gpio.High } else { Gpio.Low }
  }
  (use Gpio.Gpio).write(pin, state) escape { Gpio.GpioError(_) -> () }
}
pub fn initialize() -> Int {
  with BoardUart {
    uart = use Uart.Uart
    uart.configure(ID, Uart.UartConfig(115200, Uart.Bits8, Uart.One, Uart.NoParity, Uart.Both, Uart.NoFlowControl, Uart.By16))
    uart.set_receive_mode(ID, Uart.InterruptReceive)
    callback = CALLBACK
    Uart.bind_interrupt(ID, callback)
    bind = Uart.bind_interrupt
    bind(Uart.Uart2, on_uart)
    uart.enable_interrupt(ID, Interrupt.High, True)
    uart.disable_interrupt(ID)
    (fail Message(String.append("main", Int.to_string(1)))) escape { Message(s) -> String.byte_size(s) }
  } escape { Uart.UartError(_) -> -1 }
}
pub fn classify(status: Int) -> Int {
  { Uart.check_status(status)
    0 } escape { Uart.UartError(kind) -> kind match {
      Uart.InvalidArgument -> 1
      Uart.CapacityExceeded -> 2
      Uart.NotConfigured -> 3
      Uart.Unsupported -> 4
      Uart.Timeout -> 5
      Uart.Busy -> 6
      Uart.ResourceConflict -> 7
      Uart.InvalidState -> 8
      Uart.Parity -> 10
      Uart.Framing -> 11
      Uart.Overrun -> 12
      Uart.Other -> 9
    } }
}
pub fn utilities() -> Int {
  with BoardUart {
    xs = (use Uart.Uart).receive_some(ID, 4, Int64.from_int(0))
    (use Uart.Uart).discard_input(ID, 7) + List.length(xs)
  } escape { Uart.UartError(_) -> -1 }
}
