# The Emela interface for GPIO.
# The selected board definition maps logical pin IDs to physical pins.
# The board manages interrupt service routines and their connections.
import Std.Embedded.Interrupt.{InterruptPriority}

## A logical pin ID defined by the board and resolved by the embedded implementation.
pub type GpioPin(id: Int)
pub enum PinState { Low, High }
pub enum Pull { NoPull, Up, Down }
pub enum GpioConfig {
  Input(pull: Pull)
  OutputPushPull(pull: Pull, initial: PinState)
  OutputOpenDrain(pull: Pull, initial: PinState)
  Analog(pull: Pull)
}
pub enum Edge { Rising, Falling, Both }
pub type GpioEvent(pin: GpioPin, level: PinState)
pub enum GpioErrorKind {
  InvalidArgument
  NotConfigured
  Unsupported
  Busy
  ResourceConflict
  InvalidState
  Other
}
pub error GpioError(kind: GpioErrorKind)

# Dedicated compiler/BSP bridge; this is not the general C FFI.
@external(c, "__emela_gpio_register_interrupt")
fn register_interrupt[R: Immediate](pin: GpioPin, callback: fn(GpioEvent) -> () fails {} use R) -> Int use {}

@external(c, "__emela_gpio_error_kind")
fn error_kind(status: Int) -> GpioErrorKind use {}

## The pin and capture-free named callback must be statically resolvable.
## The embedded compiler checks the callback and connects its GPIO read/write to the ISR driver.
pub fn bind_interrupt[R: Immediate](pin: GpioPin, callback: fn(GpioEvent) -> () fails {} use R) -> () fails GpioError {
  check_status(register_interrupt(pin, callback))
}

# The compiler generates this conversion from the common BSP status table.
pub fn check_status(status: Int) -> () fails GpioError {
  if status == 0 { () } else { fail GpioError(error_kind(status)) }
}

pub effect Gpio {
  fn configure(
    pin: GpioPin,
    config: GpioConfig
  ) -> () fails GpioError
  fn read(pin: GpioPin) -> PinState fails GpioError
  fn write(pin: GpioPin, state: PinState) -> () fails GpioError
  fn toggle(pin: GpioPin) -> () fails GpioError
  fn enable_interrupt(pin: GpioPin, edge: Edge, priority: InterruptPriority) -> () fails GpioError
  fn disable_interrupt(pin: GpioPin) -> () fails GpioError
}
